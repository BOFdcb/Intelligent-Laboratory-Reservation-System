# 应用
APP_NAME=智能实验室预约系统
DEBUG=true
# JWT
SECRET_KEY=please-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# SQLite 数据库文件路径
DATABASE_URL=sqlite:///./data/lab.db
# 大模型（OpenAI 兼容协议）
LLM_BASE_URL=https://api.minimax.cn/v1
LLM_API_KEY=sk-your-minimax-key
LLM_MODEL=MiniMax-M3
# 嵌入模型（SiliconFlow）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-your-siliconflow-key
EMBED_MODEL_NAME=Pro/BAAI/bge-m3
EMBED_DIM=1024
# ChromaDB（Docker）
CHROMA_HOST=localhost
CHROMA_PORT=8000
